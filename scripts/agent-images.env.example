# Copy this file to scripts/.agent-images.env, or run:
#   ./scripts/setup-agent-images.sh
#
# This file contains deployment settings only. Do not store AWS credentials here.

# Supported values: docker, finch
CONTAINER_ENGINE=docker

# Optional AWS CLI profile. Leave empty to use the default credential chain.
AWS_PROFILE=

# Region containing the ECR repositories and AgentCore runtimes.
AWS_REGION=us-east-1

# Safety guard. Pushes fail when the active credentials resolve to another account.
# The setup script detects this value with aws sts get-caller-identity.
AWS_ACCOUNT_ID=

# AgentCore container images use ARM64.
IMAGE_PLATFORM=linux/arm64

# Each repository is formed as: <prefix><agent-name>
ECR_REPOSITORY_PREFIX=bedrock-agentcore-

# Optional full registry override. Leave empty for:
# <account>.dkr.ecr.<region>.amazonaws.com
ECR_REGISTRY=

# Optional suffix appended to generated UTC image tags.
IMAGE_TAG_SUFFIX=

# Output maps consumed when updating AgentCore runtimes.
PUSH_RESULTS_FILE=scripts/.rebuild-results.json
LOCAL_RESULTS_FILE=scripts/.rebuild-results.local.json
